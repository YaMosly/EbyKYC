<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EbyKYC</AssemblyName>
    <Product>EbyKYC</Product>
    <ApplicationIcon>relay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <Content Include="Terminal\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="relay.ico" />
    <EmbeddedResource Include="ClaudeHistory.py" LogicalName="ClaudeHistory.py" />
  </ItemGroup>
</Project>
