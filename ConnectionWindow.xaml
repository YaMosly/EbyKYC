<Window x:Class="Relay.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EbyKYC · Подключение SSH"
        SizeToContent="Height" Width="490" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource RelayWindow}" Icon="relay.ico">
  <StackPanel Margin="24">
    <TextBlock Text="Подключение SSH" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Укажи SSH-алиас и имя сессии tmux. Ключи и настройки берутся из OpenSSH."
               TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/>
    <Label Target="{Binding ElementName=HostInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,5">SSH-алиас</Label>
    <TextBox x:Name="HostInput" AutomationProperties.Name="SSH-алиас" MaxLength="128" Margin="0,0,0,13"/>
    <Label Target="{Binding ElementName=SessionInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,5">Сессия tmux</Label>
    <TextBox x:Name="SessionInput" AutomationProperties.Name="Сессия tmux" MaxLength="64" Text="claude"/>
    <TextBlock x:Name="Error" Foreground="#FFADB1" TextWrapping="Wrap" Margin="0,11,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" IsCancel="True" Style="{StaticResource Action}" Margin="0,0,8,0"/>
      <Button IsDefault="True" Style="{StaticResource Primary}" Click="Accept">
        <TextBlock Text="Подключиться" Foreground="#11291F"/>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
